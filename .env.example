DATABASE_URL=postgres://agents:agents@localhost:5432/agents
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agents-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
AGENT_URL=http://localhost:3001
LLM_URL=http://localhost:3002
TENANT_ID=local-tenant
LLM_PROVIDER=mock
AGENT_RUNTIME=basic-rag
POSTGRES_USER=agents
POSTGRES_PASSWORD=agents
POSTGRES_DB=agents
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Local Ollama (chat and embeddings). From Docker use http://host.docker.internal:11434/v1
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:4b
# LLM_EMBEDDING_MODEL=nomic-embed-text   # 768 dimensions; must match the pgvector column
# LLM_TIMEOUT_MS=120000   # gateway + upstream timeout (default 30000); raise for slow local models

# Retrieval filters, applied before prompting (cosine similarity, 0-1; 0 disables).
# Small local models get distracted by irrelevant sources. Scores are model-specific: with
# nomic-embed-text a correct best hit often scores only 0.5, so prefer a low floor plus a margin
# below the best hit over a high absolute threshold (0.6 returned nothing for many questions).
# RETRIEVAL_MIN_SCORE=0.45
# RETRIEVAL_SCORE_MARGIN=0.1
